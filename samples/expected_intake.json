{
  "sample-01": {
    "imitates": "N1",
    "owner": "network",
    "note": "latency on the source path: ingest read timeouts, data goes stale",
    "alerts": [
      "IngestJobFailing",
      "OrdersMartStale"
    ],
    "components": [
      "ingest",
      "marts"
    ],
    "must_have_signals": [
      "network_timeout",
      "stale_data"
    ],
    "must_not_have_signals": [
      "lock_timeout",
      "statement_timeout",
      "connection_reset",
      "name_resolution",
      "disk_full"
    ]
  },
