{
  "$defs": {
    "PlanOption": {
      "description": "One plan the optimizer considered, so a human can see why the chosen one won.",
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "actions": {
          "items": {
            "type": "string"
          },
          "title": "Actions",
          "type": "array"
        },
        "p_fixed": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "P Fixed",
          "type": "number"
        },
        "expected_loss": {
          "title": "Expected Loss",
          "type": "number"
        },
        "chosen": {
          "default": false,
          "title": "Chosen",
          "type": "boolean"
        }
      },
      "required": [
        "label",
        "p_fixed",
        "expected_loss"
      ],
      "title": "PlanOption",
      "type": "object"
    },
    "PlannedAction": {
      "properties": {
        "intent": {
          "title": "Intent",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Risk",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "stage": {
          "default": 1,
          "minimum": 1,
          "title": "Stage",
          "type": "integer"
        }
      },
      "required": [
        "intent",
        "target",
        "risk",
        "rationale"
      ],
      "title": "PlannedAction",
      "type": "object"
    },
    "PolicyDecision": {
      "properties": {
        "approved": {
          "title": "Approved",
          "type": "boolean"
        },
        "needs_human": {
          "title": "Needs Human",
          "type": "boolean"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "approved",
        "needs_human"
      ],
      "title": "PolicyDecision",
      "type": "object"
    },
    "Precedent": {
      "description": "A similar past incident behind the plan (from the history agent), so a human sees why it is trusted.",
      "properties": {
        "incident_id": {
          "title": "Incident Id",
          "type": "string"
        },
        "similarity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Similarity",
          "type": "number"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "fix": {
          "items": {
            "type": "string"
          },
          "title": "Fix",
          "type": "array"
        },
        "verified_by": {
          "default": "",
          "title": "Verified By",
          "type": "string"
        }
      },
      "required": [
        "incident_id",
        "similarity"
      ],
      "title": "Precedent",
      "type": "object"
    }
  },
  "description": "Controller -> executor. One plan per incident.",
  "properties": {
    "schema_version": {
      "default": "1.3",
      "title": "Schema Version",
      "type": "string"
    },
    "incident_id": {
      "title": "Incident Id",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "kind": {
      "default": "remediate",
      "enum": [
        "remediate",
        "approve",
        "escalate"
      ],
      "title": "Kind",
      "type": "string"
    },
    "owner": {
      "title": "Owner",
      "type": "string"
    },
    "team": {
      "items": {
        "type": "string"
      },
      "title": "Team",
      "type": "array"
    },
    "root_cause": {
      "title": "Root Cause",
      "type": "string"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "evidence": {
      "items": {
        "type": "string"
      },
      "title": "Evidence",
      "type": "array"
    },
    "actions": {
      "items": {
        "$ref": "#/$defs/PlannedAction"
      },
      "title": "Actions",
      "type": "array"
    },
    "expected_loss": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Loss"
    },
    "options": {
      "items": {
        "$ref": "#/$defs/PlanOption"
      },
      "title": "Options",
      "type": "array"
    },
    "precedents": {
      "items": {
        "$ref": "#/$defs/Precedent"
      },
      "title": "Precedents",
      "type": "array"
    },
    "policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/PolicyDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "incident_id",
    "owner",
    "team",
    "root_cause",
    "confidence"
  ],
  "title": "RemediationPlan",
  "type": "object"
}
