{
  "$defs": {
    "ActionOutcome": {
      "properties": {
        "intent": {
          "title": "Intent",
          "type": "string"
        },
        "status": {
          "enum": [
            "done",
            "failed",
            "skipped",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "intent",
        "status"
      ],
      "title": "ActionOutcome",
      "type": "object"
    }
  },
  "description": "Executor -> controller. `resolved` must come from the platform's own health checks.",
  "properties": {
    "schema_version": {
      "default": "1.3",
      "title": "Schema Version",
      "type": "string"
    },
    "incident_id": {
      "title": "Incident Id",
      "type": "string"
    },
    "outcomes": {
      "items": {
        "$ref": "#/$defs/ActionOutcome"
      },
      "title": "Outcomes",
      "type": "array"
    },
    "resolved": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolved"
    },
    "verified_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verified At"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    }
  },
  "required": [
    "incident_id",
    "outcomes"
  ],
  "title": "ExecutionReport",
  "type": "object"
}
