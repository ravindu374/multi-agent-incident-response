{
  "name": "a2a-oncall",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  "postCreateCommand": "pip install -e '.[dev]' && python -m oncall init",
  "forwardPorts": [9090, 18001]
}
